{{- $index := slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout "archives") (ne .Layout "search") -}}
        {{- $index = $index | append (dict "title" .Title "content" .Plain "permalink" .RelPermalink "section" .Section "summary" (.Description | default (.Summary | plainify)) "tags" (.Params.tags | default slice)) -}}
    {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
